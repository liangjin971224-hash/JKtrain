# ============================================================
# 健康顾问培训系统 · 环境变量示例
# 复制为 .env 后按实际环境填写：cp .env.example .env
# ============================================================

# ----- Neo4j 图谱（156 节点 / 184 关系，已入库） -----
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=12345678
# 库名走配置，不硬编码（门禁要求）
NEO4J_DATABASE=jiankangshujuku

# ----- Milvus 向量库（4 个 collection / 580 条，已重建） -----
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_TIMEOUT=10

# ----- MySQL 业务库（P6/P7 才用到） -----
DATABASE_URL=mysql+pymysql://root:12345678@localhost:3306/health_training?charset=utf8mb4

# ----- Embedding（bge-m3，1024 维） -----
# 模型目录必须存在，否则启动自检报错
EMBED_MODEL_DIR=D:\ai260803\xiangmudaima\pytorch\model\bge-m3
EXPECTED_EMBED_DIM=1024
# 4096 序列长度下 8GB 显存需按长度分桶编码，否则 OOM
EMBED_MAX_SEQ_LENGTH=4096

# ----- LLM 主备双通道 -----
# 设计：千问为主，DeepSeek 为备。千问任何异常（超时/限流/5xx/返回无法解析）
# 自动切到 DeepSeek，切换过程对上层透明。
# 空值不阻塞启动，但问答生成不可用（启动自检只警告）
LLM_PRIMARY=qwen                  # qwen | deepseek
LLM_FALLBACK_ENABLED=true         # 是否启用兜底切换
# 切到备用前的重试次数（不含首次）。0 = 主模型失败立刻切
LLM_PRIMARY_RETRIES=1
# 单次调用超时（秒）。超时视为失败，触发切换
LLM_TIMEOUT_SEC=30

# 主：千问（阿里云百炼 DashScope，OpenAI 兼容模式）
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# 备：DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ----- Redis（会话态 / 临时结果） -----
# 未安装 redis 包时 CachePort 回退到内存实现
REDIS_URL=redis://localhost:6379/0

# ----- 文件存储（答卷归档） -----
FILE_STORAGE_ROOT=./data
FILE_STORAGE_MAX_MB=20

# ----- 向量 collection 名（不硬编码在代码里） -----
COLL_TRAINING=health_training_docs
COLL_CASE=health_case_library
COLL_QUESTION=health_question_bank
COLL_SELF_TEST=health_self_test

# ----- 运行 -----
LOG_LEVEL=INFO
APP_ENV=local

# ---------------- Rerank 候选重排（可选增强） ----------------
# 作用：对 RRF 融合后的候选按「问题-文档」相关性重新打分，
#       补 RRF「只看排名不看内容」的盲区。
#
# 实测（44 条评测集，单变量对比）：
#   不重排      R@1 0.545 / R@5 0.773
#   候选20 重排 R@1 0.591 / R@5 0.750  耗时 608ms
#   → R@1 +0.045，代价是 R@5 -0.023 与约 0.6s 延迟
#
# ★ 默认 false：模型约 2.1GB 显存，与 bge-m3（约 2.5GB）叠加后 8GB 卡余量紧。
#   模型缺失或加载失败时适配器自动降级为原顺序，不会影响出答案。
RERANK_ENABLED=false
RERANK_MODEL_DIR=D://ai260803//xiangmudaima//pytorch//model//bge-reranker-v2-m3
# 送入重排的候选条数（实测 20 已足够，30 与 20 结果相同）
RERANK_CANDIDATES=20
# 重排后进 prompt 的参考资料条数
RERANK_TOP_K=5
RERANK_BATCH_SIZE=8
RERANK_MAX_LENGTH=512

# ---------------- 缓存后端 ----------------
# memory = 进程内字典（单实例够用，重启即丢）
# redis  = Redis（多实例共享、重启可恢复）
#
# ★ 什么时候必须换 redis：
#   水平扩容（多个进程/实例）时**会话状态必须共享**，否则演练游标
#   （当前问到第几句）会错乱——A 实例存、B 实例读不到。
#
# ★ 规划结果缓存不需要 redis：它幂等，内存版最坏只是少省一次调用。
#
# ★ redis 连不上会自动降级为内存版，不会让启动失败：
#   缓存是加速手段，不是功能前提。
CACHE_BACKEND=memory
REDIS_URL=redis://127.0.0.1:6379/0
# 全局键前缀，与其他应用共用实例时隔离命名空间（clear_prefix 不会误删别人）
REDIS_KEY_PREFIX=health_training:
# 连接/读写超时（秒）。必须设——Redis 卡住不该拖死请求线程。
REDIS_SOCKET_TIMEOUT=2.0

# ---------------- LLM 多跳规划复核（可选增强） ----------------
# 规则先跑，只有结果「可疑」时才让 LLM 复核「拆几步、谁依赖谁」。
#
# 四个触发条件（任一满足才调）：
#   1. 有片段被判为非问题而丢弃（如「这几样给我挑个划算的」被整段丢掉）
#   2. 多步且含顺序性暗示但规则没判出依赖（如「不行的话有什么替代」）
#   3. 三步及以上、第二步起全部标依赖（可能把并列误判）
#   4. 单步但原文含多个问号
#
# 实测（9 题）：触发率 22%，采纳率 100%，且 2 题都产生了改进：
#   规则丢掉的「这几样给我挑个划算的」→ 拆成比价第二步
#   规则判不出依赖的「不行的话有什么替代」→ 正确标为依赖
#
# ★ 默认 false：规则已覆盖常见问法，需实测确认收益后再常开。
#   输出必须过六道校验（步数上限/依赖合法性/kind 白名单/不许原句复读…），
#   不过就退回规则结果 —— LLM 挂了系统行为与改造前一致。
PLANNER_USE_LLM=false
# 每请求最多调几次（守住成本红线）
PLANNER_MAX_CALLS=1
# 最多拆几步（与 domain 层 MAX_STEPS 对齐，不能超 3）
PLANNER_MAX_STEPS=3
# 规划结果缓存秒数（培训场景学员反复问相似问题，缓存收益明显）
PLANNER_CACHE_TTL_SEC=300

# ═══════════════════════════════════════════════════════════════════
# 本地模型（LLM_PRIMARY=local 时生效）
# ═══════════════════════════════════════════════════════════════════
# 默认 qwen（云端），本地模型仅用于断网/内网演示/离线批处理。
# ★ 实测 1.5B 单次回答 15-21s、3B 30-38s，不适合在线问答。
LLM_PRIMARY=qwen

# 基座模型目录（Qwen2.5-Instruct 格式）
LOCAL_MODEL_PATH=

# 是否 4bit 量化加载。8GB 显存跑 3B 必须 true，1.5B 可 false（更快更准）
LOCAL_LOAD_IN_4BIT=true

# 单次生成 token 上限（防止误传打爆显存）
LOCAL_MAX_NEW_TOKENS=1024

# ── LoRA 适配器（微调后的权重，可选）──────────────────────────────
# 留空 = 用基座模型原样；填目录 = 在基座上挂载 LoRA。
#
# 两版权重选一（不要同时启用）：
#   09_训练数据/lora_out       ❌ 不推荐：1.5B，答案会「答非所问」
#                             例：「阿司匹林能吃吗」→「不可以擅自停药」
#   09_训练数据/lora_out_3b    ✅ 推荐：3B QLoRA，能正确回答禁忌类问题
#
# ★ 实测差异（真实链路 5 题）：
#   鱼油批准功能    1.5B ✅ 照抄准确 | 3B ✅ 照抄准确
#   阿司匹林能吃吗  1.5B ❌ 答非所问 | 3B ✅ 正确劝阻
#   蛋白粉能增强免疫 1.5B ⚠️ 护栏拦截(93.9s) | 3B ✅ 直接答对(37.9s)
#
# ★ 基座必须与训练时一致：lora_out_3b 只能配 Qwen2.5-3B，配错会加载失败。
LOCAL_LORA_PATH=
